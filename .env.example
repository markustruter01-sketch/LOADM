# Required
DATABASE_URL=postgresql://user:password@host:5432/loadm

# Optional
NODE_ENV=development
PORT=5000
UPLOAD_DIR=uploads
# UTC hour at which demo data resets daily (0-23). Empty disables.
DEMO_RESET_HOUR_UTC=16
# Seed the database on first boot when it is empty
SEED_ON_BOOT=true
LOG_LEVEL=debug
