# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/loadmworkflow

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Session Security
SESSION_SECRET=your_secure_random_session_secret_here

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5000

# Optional: OpenAI Integration (if using AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Notes:
# - Copy this file to .env and fill in your actual values
# - Never commit .env file to version control
# - Generate a strong SESSION_SECRET (minimum 32 characters)
# - DATABASE_URL should point to your PostgreSQL instance
# - SENDGRID_API_KEY requires a verified sender email in SendGrid